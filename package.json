{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev",
    "check:content": "tsx scripts/check-content-parity.ts",
    "generate:cv": "tsx scripts/generate-cv.tsx",
    "subset:font": "tsx scripts/subset-bricolage.ts",
    "check:stage-chunk": "tsx scripts/check-stage-chunk.ts",
    "prebuild": "pnpm check:content && pnpm generate:cv && pnpm subset:font",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:unit": "echo 'No unit tests — the particle stage suite was removed.'",
    "test:launch": "LAUNCH_ONLY=1 playwright test --project=launch",
    "lhci:webgl": "lhci autorun --config=lighthouserc.webgl.json"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.4",
    "next-intl": "^4.14.3",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@content-collections/core": "^0.15.2",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@react-pdf/renderer": "4.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/subset-font": "^2.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "geist": "1.7.2",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^6",
    "zod": "^4.4.3"
  }
}
